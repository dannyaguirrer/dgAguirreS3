<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dgAguirreS3.Views.vRegistro"
             Title="vRegistro">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label 
            Text="REGISTRO DE NUEVO USUARIO"
            FontSize="Title"
            TextColor="Coral"
            FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label
            Text="Ingrese Usuario nuevo"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>
        <Entry x:Name="txtUsuarioNuevo" Placeholder="Ingrese nuevo usuario" />
        <Label Text="Ingrese nueva contraseña"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        <Entry x:Name="txtNuevaContrasena" Placeholder="Ingresar nueva clave" IsPassword="True"/>



        <Grid ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnAgregarUsuario"  Text="Agregar Usuario"
                Clicked="btnAgregarUsuario_Clicked" 
                      Grid.Row="0" 
                      Grid.Column="0"/>
            <Button
            Text="Volver al inicio"
            Clicked="btnVolver_Clicked" 
                Grid.Row="1" 
                Grid.Column="1"/>
            </Grid>
    </VerticalStackLayout>
</ContentPage>